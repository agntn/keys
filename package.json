{
  "name": "@agntn/keys",
  "version": "0.7.0",
  "description": "Cryptographic key generation, derivation, addresses, and message signing across blockchains",
  "keywords": [
    "addresses",
    "aptos",
    "arweave",
    "bitcoin",
    "blockchain",
    "cardano",
    "cosmos",
    "crypto",
    "cryptocurrency",
    "cryptography",
    "keys",
    "monero",
    "near",
    "openpgp",
    "polkadot",
    "solana",
    "stellar",
    "sui",
    "ton",
    "tron",
    "typescript",
    "wallet"
  ],
  "homepage": "https://keys.agntn.dev",
  "bugs": {
    "url": "https://github.com/agntn/keys/issues"
  },
  "license": "MIT",
  "author": "oritwoen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/keys.git"
  },
  "bin": {
    "keys": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "extensions/omp",
    "extensions/pi"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./blockchains/*": {
      "types": "./dist/blockchains/*.d.mts",
      "default": "./dist/blockchains/*.mjs"
    },
    "./arweave": {
      "types": "./dist/utils/arweave/index.d.mts",
      "default": "./dist/utils/arweave/index.mjs"
    },
    "./bip32": {
      "types": "./dist/utils/bip32/index.d.mts",
      "default": "./dist/utils/bip32/index.mjs"
    },
    "./bip322": {
      "types": "./dist/utils/bip322/index.d.mts",
      "default": "./dist/utils/bip322/index.mjs"
    },
    "./bip38": {
      "types": "./dist/utils/bip38/index.d.mts",
      "default": "./dist/utils/bip38/index.mjs"
    },
    "./brainwallet": {
      "types": "./dist/utils/brainwallet/index.d.mts",
      "default": "./dist/utils/brainwallet/index.mjs"
    },
    "./bip39": {
      "types": "./dist/utils/bip39/index.d.mts",
      "default": "./dist/utils/bip39/index.mjs"
    },
    "./bip44": {
      "types": "./dist/utils/bip44/index.d.mts",
      "default": "./dist/utils/bip44/index.mjs"
    },
    "./curve": {
      "types": "./dist/utils/curve/index.d.mts",
      "default": "./dist/utils/curve/index.mjs"
    },
    "./descriptor": {
      "types": "./dist/utils/descriptor/index.d.mts",
      "default": "./dist/utils/descriptor/index.mjs"
    },
    "./electrum": {
      "types": "./dist/utils/electrum/index.d.mts",
      "default": "./dist/utils/electrum/index.mjs"
    },
    "./openpgp": {
      "types": "./dist/utils/openpgp/index.d.mts",
      "default": "./dist/utils/openpgp/index.mjs"
    },
    "./script": {
      "types": "./dist/utils/script/index.d.mts",
      "default": "./dist/utils/script/index.mjs"
    },
    "./secp256k1": {
      "types": "./dist/utils/secp256k1/index.d.mts",
      "default": "./dist/utils/secp256k1/index.mjs"
    },
    "./store": {
      "types": "./dist/utils/store/index.d.mts",
      "default": "./dist/utils/store/index.mjs"
    },
    "./slip10": {
      "types": "./dist/utils/slip10/index.d.mts",
      "default": "./dist/utils/slip10/index.mjs"
    },
    "./transaction": {
      "types": "./dist/utils/transaction/index.d.mts",
      "default": "./dist/utils/transaction/index.mjs"
    },
    "./wif": {
      "types": "./dist/utils/wif/index.d.mts",
      "default": "./dist/utils/wif/index.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "default": "./dist/mcp.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev": "vp test watch",
    "prepack": "obuild",
    "fmt": "obuild && vp lint --fix && vp fmt",
    "lint": "obuild && vp lint && vp fmt --check",
    "lint:fix": "obuild && vp lint --fix && vp fmt",
    "test": "pnpm lint && pnpm test:types && pnpm build && pnpm test:ext && vp test run --coverage --maxWorkers=8 && node test/eval-mcp.mjs",
    "test:types": "tsc --noEmit --skipLibCheck && tsc -p tsconfig.type-tests.json --noEmit --skipLibCheck && pnpm --dir docs typecheck",
    "test:ext": "tsc -p tsconfig.extensions.json --noEmit",
    "test:mcp": "pnpm build && node test/eval-mcp.mjs",
    "playground": "tsx",
    "playground:bip32": "tsx playground/bip32-demo.ts",
    "playground:slip10": "tsx playground/slip10-demo.ts",
    "playground:bip39": "tsx playground/bip39-demo.ts",
    "playground:bip44": "tsx playground/bip44-demo.ts",
    "playground:signing": "tsx playground/signing-demo.ts",
    "docs": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build"
  },
  "dependencies": {
    "@agntn/ciphers": "0.5.2",
    "@agntn/curves": "0.2.1",
    "@agntn/encodings": "0.1.2",
    "@agntn/hashes": "0.7.1",
    "@agntn/tools": "0.2.3",
    "@modelcontextprotocol/server": "2.2.0",
    "@noble/curves": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "micro-key-producer": "0.10.2"
  },
  "devDependencies": {
    "@agntn/ox": "0.1.0",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@earendil-works/pi-tui": "0.99.2",
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@oh-my-pi/pi-coding-agent": "18.4.12",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "4.1.11",
    "jiti": "2.7.0",
    "obuild": "0.4.43",
    "tsx": "4.23.15",
    "typebox": "1.3.34",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.11.2",
  "omp": {
    "extensions": [
      "./extensions/omp/keys.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/pi/*.ts"
    ],
    "image": "https://keys.agntn.dev/image.png"
  }
}
